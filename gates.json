      "name": "qwen38-trace-f32",
      "family": "qwen38",
      "tier": "verify",
      "model": "qwen38",
      "paths": [
        "build.zig",
        "inference/build.zig",
        "inference/src/backends/metal/**",
        "inference/src/formats/**",
        "inference/src/models/inventory.zig",
        "inference/src/models/qwen35*.zig",
