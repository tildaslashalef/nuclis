        "inference/src/quant/**",
        "inference/src/root.zig",
        "inference/src/runtime/**",
        "inference/src/tensor/**"
      ],
      "command": [
        "{nuclis}",
        "generate",
        "--backend",
        "metal",
        "--model",
        "{model}",
        "--kv",
        "f32",
        "--raw",
        "--prompt",
        "Hello,",
        "--max-tokens",
        "1",
        "--ctx-size",
        "8",
        "--logits",
        "{trace}/logits.f32",
        "--trace-dir",
        "{trace}"
      ],
      "comparator": {
        "kind": "trace",
        "reference": "tests/fixtures/reference-hello-comma",
