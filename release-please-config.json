{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "draft": true,
  "force-tag-creation": true,
  "pull-request-title-pattern": "chore: release v${version}",
  "pull-request-header": "The next release. Write its highlights at the top of the CHANGELOG section before merging; merging tags it, and the release workflow builds, attests, and publishes it.",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "build", "section": "Build" },
    { "type": "docs", "section": "Documentation" },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true }
  ],
  "packages": {
    ".": {
      "extra-files": [
        { "type": "generic", "path": "build.zig.zon" },
        { "type": "generic", "path": "inference/build.zig.zon" },
        { "type": "generic", "path": "huggingface/build.zig.zon" }
      ]
    }
  }
}
